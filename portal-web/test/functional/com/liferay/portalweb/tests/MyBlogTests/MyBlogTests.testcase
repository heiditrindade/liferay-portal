@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		task("Set up instance and login") {
			TestCase.setUpPortalInstance();
		
			User.firstLoginPG();
		}
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");
		task("Add a blog entry") {
			JSONLayout.addWidgetToPublicLayout(
				column = "1",
				groupName = "Guest",
				layoutName = "Blogs Page",
				widgetName = "Blogs");

			Navigator.gotoPage(pageName = "Blogs Page");

			JSONBlog.addEntry(
				entryContent = "Blogs Entry Content 1",
				entryTitle = "Blogs Entry Title 1");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			BlogsEntry.tearDownCP();

			Blogs.tearDownConfigurationDisplaySettingsPG(
				pageName = "Blogs Page",
				portletName = "Blogs");

			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");

			PagesAdmin.tearDownCP();
		}
	}

    @description = "Can Search Blogs"
    @priority = "5"
    test CanSearchBlogs {
        task ("Add blogs entry") {
            JSONBlog.addEntry(
                entryContent = "Blogs Entry Content 2",
                entryTitle = "Blogs Entry Title 2");
        }
        task("Search for blogs entry") {
            Navigator.openURL();

            SearchPortlets.searchEmbedded(searchTerm = ""Blogs Entry Title 1"");
        }
        task("Assert searched title") {
            SearchResultPortlet.viewSearchResults(
                searchAssetTitle = "Blogs Entry Title 1",
                searchAssetType = "Blogs Entry");

			SearchResultPortlet.viewSearchResultNotPresent(
				searchAssetTitle = "Blogs Entry Title 2",
				searchAssetType = "Blogs Entry");
        }
    }


}