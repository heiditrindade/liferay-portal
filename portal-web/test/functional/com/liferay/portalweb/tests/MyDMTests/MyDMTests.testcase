@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		task ("Set up instance and login") {
			TestCase.setUpPortalInstance();

			User.firstLoginPG();
		}

		task ("Add Documents and Media Page and Widget") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page");

			JSONLayout.addWidgetToPublicLayout(
				column = "1",
				groupName = "Guest",
				layoutName = "Documents and Media Page",
				widgetName = "Documents and Media");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DMDocument.tearDownCP();

			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page");

			User.logoutPG();
		}
	}

	@description = "Can Download a Documents and Media"
	@priority = "5"
	test CanDownloadDM {
		task ("Add files to DM widget") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentDescription = "DM Document Description",
				dmDocumentTitle = "Document_1.jpg",
				groupName = "Guest",
				mimeType = "image/jpeg",
				sourceFileName = "Document_1.jpg");

			JSONDocument.addFileWithUploadedFile(
				dmDocumentDescription = "DM Document Description",
				dmDocumentTitle = "marketplace_icon.png",
				groupName = "Guest",
				mimeType = "image/jpeg",
				sourceFileName = "marketplace_icon.png");
		}

		task ("Download file") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.downloadCP(
				dmDocumentSize = "13 KB",
				dmDocumentTitle = "Document_1.jpg");

		}

		task ("Assert that file was downloaded") {

			DMDocument.assertFileNameFromTempFolder(fileName = "Document_1.jpg");

		}

		task ("Asser that file wasn't downloaded") {

			DMDocument.assertNoFileNameFromTempFolder(fileName = "marketplace_icon.png");
		}

	}

}