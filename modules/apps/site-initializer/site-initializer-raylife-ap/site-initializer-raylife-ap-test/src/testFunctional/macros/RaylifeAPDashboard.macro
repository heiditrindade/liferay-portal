definition {

    macro changeTimeFilter {
        var dashboardTitle = StringUtil.lowerCase("${dashboardTitle}");

		Select(
            locator1 = "RaylifeAPDashboard#DASHBOARD_TIME_FILTER",
			key_dashboardTitle = "${dashboardTitle}",
            value1 = "${timeFilter}");
	}

    macro getCommissionEventValue {
        if (!(isSet(eventIndex))) {
            var eventIndex = "0";
        }

        MouseOver(
			locator1 = "RaylifeAPDashboard#COMMISSION_EVENT",
			key_index = "${eventIndex}");

		var commissionValue = selenium.getText("RaylifeAPDashboard#COMMISSION_EVENT_TEXT");

		var commissionValue = StringUtil.extractLast("${commissionValue}", "$");

        return "${commissionValue}";
	}


}